# Environment (development veya production)
NODE_ENV=development

# MongoDB Database URL
# Local development için MongoDB gerekiyor
# Eğer MongoDB yoksa, ücretsiz MongoDB Atlas kullanabilirsiniz: https://cloud.mongodb.com
DATABASE_URL="mongodb://localhost:27017/uniplan"

# JWT Secret Key - güvenlik için değiştirin
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Port
PORT=5000
